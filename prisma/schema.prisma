// Schema do GestorPro — gestão de revenda de streaming
// Multi-tenant: todo dado de negócio é escopado por revendedorId

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  ADMIN
  REVENDEDOR
}

enum StatusAssinatura {
  TRIAL
  ATIVO
  PAUSADO
  CANCELADO
}

enum PlanoAssinatura {
  MENSAL
  SEMESTRAL
  ANUAL
}

enum PlanoCliente {
  MENSAL
  DOIS_MESES
  TRIMESTRAL
  SEMESTRAL
}

enum StatusCliente {
  TESTE
  ATIVO
  VENCIDO
  CANCELADO
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
}

enum DestinoAviso {
  TODOS_REVENDEDORES
  UM_REVENDEDOR
  TODOS_CLIENTES
  CLIENTES_DO_SERVICO
}

// GERAL cobre os comunicados de sempre (cupom, dica de manual, aviso livre).
// ATUALIZACAO marca especificamente uma novidade do sistema em si — recebe
// selo próprio no sininho do revendedor, pra se distinguir de promoção/aviso.
enum TipoAviso {
  GERAL
  ATUALIZACAO
}

enum TipoPagamento {
  ASSINATURA
  RENOVACAO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

enum TipoCupom {
  PERCENTUAL
  FIXO
}

enum GatewayPagamento {
  MERCADOPAGO
  ASAAS
}

model Revendedor {
  id        String   @id @default(cuid())
  nome      String
  cpf       String?
  whatsapp  String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(REVENDEDOR)
  criadoEm  DateTime @default(now())

  statusAssinatura   StatusAssinatura @default(TRIAL)
  planoAssinatura    PlanoAssinatura?
  trialFim           DateTime
  assinaturaVence    DateTime?
  pausadoEm          DateTime?
  motivoPausa        String?

  // Identidade do negócio (não a conta do revendedor) — usados como
  // remetente nas mensagens de cobrança e, no futuro, em recibos/e-mails.
  // Nulos pra quem cadastrou antes desses campos existirem.
  nomeNegocio String?
  cidade      String?

  // Liga/desliga o disparo automático (via WhatsApp Cloud API, quando
  // conectado — ver whatsappTelefoneNumeroId abaixo) da mensagem "Lembrete"
  // de cobrança em cada etapa do vencimento do cliente. Sem o WhatsApp
  // conectado esses três ficam sem efeito (nada pra mandar por), mas o
  // valor salvo continua pra quando o revendedor conectar depois.
  lembreteAntesAtivo     Boolean @default(true)
  avisoVencimentoAtivo   Boolean @default(true)
  cobrancaAposVencerAtiva Boolean @default(false)

  // Saldo de crédito financeiro que o dono do GestorPro concede à conta do
  // revendedor (ex: compensação, bônus de indicação fora do fluxo normal de
  // cupom) — não confundir com os créditos de IPTV que cada revendedor
  // compra por conta própria em Plataformas, que são de um app/fornecedor
  // dele, não do GestorPro. Puramente informativo por enquanto: não abate
  // sozinho da próxima cobrança da assinatura.
  saldoCreditos Float @default(0)
  creditosRecebidos CreditoConta[]

  // Credenciais próprias do Mercado Pago do revendedor, para receber
  // pagamentos de renovação de seus clientes direto na conta dele.
  mpAccessToken String?
  mpPublicKey   String?

  // Gateway alternativo ao Mercado Pago — mesmo modelo (token de API
  // próprio do revendedor, dinheiro cai direto na conta dele). Guardado em
  // texto puro como o mpAccessToken: é um token de API com escopo próprio,
  // não a senha da conta (diferente do UniTV/WhatsApp acima).
  asaasApiKey String?

  // Qual dos dois gateways configurados é usado pra gerar o link de
  // cobrança de renovação — só importa quando o revendedor cadastrou os
  // dois; com só um configurado, esse é sempre o usado.
  gatewayPagamento GatewayPagamento @default(MERCADOPAGO)

  // Cancela automaticamente o cliente que ficar vencido por mais que esse
  // número de dias. Null/0 = desligado (nunca cancela sozinho).
  diasParaCancelarAutomatico Int?

  // Margem de lucro padrão (%) usada pra sugerir o preço de venda de
  // aparelhos a partir do custo médio de compra (Precificação · Maquininha).
  margemPadrao Float @default(30)

  // Meta de receita que o revendedor definiu pra si mesmo (renovações +
  // aparelhos) — mostrada como barra de progresso no Painel. Null = ainda
  // não definiu nenhuma; vale pra todo mês até ele mudar.
  metaReceitaMensal Float?

  // Mesma ideia, só que pro admin acompanhar a receita da própria
  // plataforma (assinaturas dos revendedores) no Painel do administrador —
  // campo separado porque é uma meta de negócio diferente da de cima
  // (que é sobre a operação de revenda pessoal do admin, se ele tiver uma).
  metaReceitaPlataforma Float?

  // Integração BETA com o painel da UniTV (resell.media) — login da conta
  // de revenda do usuário lá, pra permitir renovar clientes direto pelo
  // GestorPro sem abrir o painel deles. A UniTV não tem API pública
  // documentada; isso depende de engenharia reversa do painel deles e pode
  // quebrar se mudarem algo (ver src/lib/integracoes/unitv.ts). Senha
  // guardada criptografada (lib/crypto.ts), nunca em texto puro.
  unitvUsuario            String?
  unitvSenhaCriptografada String?
  unitvConectadoEm        DateTime?

  // Autoatendimento via WhatsApp Cloud API oficial (Meta) — cada revendedor
  // conecta seu próprio número/app da Meta (mesmo padrão do Mercado Pago),
  // e todos apontam o webhook pra mesma URL do GestorPro: o
  // whatsappTelefoneNumeroId (phone_number_id, único globalmente na Meta)
  // é o que identifica de qual revendedor é cada mensagem recebida. Token
  // de acesso guardado criptografado (lib/crypto.ts) — dá pra mandar
  // mensagem em nome do número, então é tão sensível quanto uma senha.
  whatsappTelefoneNumeroId   String?   @unique
  whatsappTokenCriptografado String?
  whatsappBotAtivo           Boolean   @default(false)
  whatsappConectadoEm        DateTime?

  // Taxas de parcelamento da própria maquininha do revendedor (substitui a
  // tabela de referência genérica) — { "<parcelas>": percentualComoNumero },
  // uma chave por número de parcelas de 1 a 12. Null/chave ausente = usa a
  // taxa de referência padrão pra aquela parcela.
  taxasCartaoPersonalizadas Json?

  // Motivo que o revendedor deu ao cancelar a própria assinatura do
  // GestorPro (não confundir com Cliente.motivoSaida, que é dele saindo
  // de um cliente dele).
  motivoCancelamento String?
  canceladoEm        DateTime?

  // Até quando o revendedor já leu os comunicados da Administração
  // GestorPro (Aviso com destino TODOS_REVENDEDORES) — qualquer aviso
  // criado depois disso conta como não lido no sininho de notificação.
  avisosLidosAte DateTime?

  // Indicação entre revendedores (programa de indicação do próprio
  // GestorPro) — quem trouxe esse revendedor pra plataforma.
  indicadoPorId String?
  indicadoPor   Revendedor?  @relation("IndicacaoRevendedor", fields: [indicadoPorId], references: [id], onDelete: SetNull)
  indicados     Revendedor[] @relation("IndicacaoRevendedor")

  // Último momento em que alguém dessa conta (dono ou funcionário) abriu
  // uma tela autenticada do app — atualizado com throttle em
  // exigirRevendedor() (ver src/lib/sessao.ts). Sinal direto de uso real,
  // diferente de LogAtividade (só cobre ações que gravam algo: cadastrar
  // cliente, vender, etc.) — alguém que só abre o Painel pra olhar não
  // aparecia em nenhum lugar antes disso existir.
  ultimoAcessoEm DateTime?

  // Cliques recebidos no link de indicação desse revendedor (/cadastro?ref=
  // <id>), registrados antes de qualquer cadastro acontecer — sem isso só
  // dava pra ver quem terminou de se cadastrar pelo link (indicados acima),
  // nunca quantas pessoas sequer abriram o link e desistiram no meio.
  cliquesIndicacao CliqueIndicacao[]

  servicos   Servico[]
  clientes   Cliente[]
  produtos   Produto[]
  vendas     Venda[]
  avisos     Aviso[]
  interessados   InteressadoCliente[]
  fechamentosMes FechamentoMes[]
  pagamentos     Pagamento[]
  plataformas    Plataforma[]
  chavesPix      ChavePix[]
  modelosMensagem ModeloMensagem[]
  funcionarios    Funcionario[]
  pushSubscriptions PushSubscription[]
  logsAtividade   LogAtividade[]
  notificacoesPagamento NotificacaoPagamento[]
  importacoesAntigas ImportacaoAntiga[]
  cuponsRestritos Cupom[]
  sugestoes       Sugestao[]

  @@index([indicadoPorId])
}

// Um clique no link de indicação (/cadastro?ref=<revendedorId>), gravado
// assim que a página abre — independente de a pessoa completar o cadastro
// ou não. Junto com Revendedor.indicadoPorId (só preenchido quando o
// cadastro é concluído) dá o funil completo: cliques → cadastros →
// assinantes.
model CliqueIndicacao {
  id           String     @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  criadoEm     DateTime   @default(now())

  @@index([revendedorId, criadoEm])
}

// Marca cada arquivo de backup do app antigo já importado (pelo hash do
// conteúdo) — sem isso, reimportar o mesmo arquivo duplicava todos os
// clientes, vendas, movimentos de estoque e renovações.
model ImportacaoAntiga {
  id           String   @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  hash         String
  resumo       String
  criadoEm     DateTime @default(now())

  @@unique([revendedorId, hash])
}

// Registro de ações sensíveis feitas por quem loga (dono ou funcionário) —
// pra dar pro dono visibilidade de quem fez o quê, principalmente depois
// que a conta passou a permitir logins de funcionário.
model LogAtividade {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  autorNome    String
  autorTipo    String
  acao         String
  descricao    String
  criadoEm     DateTime @default(now())

  @@index([revendedorId, criadoEm])
}

// Tentativas de login (sucesso ou falha), usadas só para bloquear força
// bruta — não guarda a senha, só o e-mail tentado e o resultado.
model TentativaLogin {
  id       String   @id @default(cuid())
  email    String
  sucesso  Boolean
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
}

// Limite genérico de chamadas por chave (ex: "cadastro:<ip>") numa janela de
// tempo — usado nas rotas públicas sem login (cadastro, recuperação de
// senha, pagamento) pra travar abuso automatizado. Cada linha é uma chamada
// contada; @@index acelera contar só as recentes por chave.
model LimiteRequisicao {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
}

// Token de recuperação de senha — vale tanto pra Revendedor quanto pra
// Funcionario (os dois logam por e-mail/senha na mesma tela), por isso não
// tem uma foreign key pra nenhuma das duas tabelas: na hora de redefinir, o
// e-mail é buscado nas duas, igual o próprio login já faz. Só o hash do
// token fica salvo (nunca o valor cru), pra um vazamento do banco não virar
// acesso direto às contas — o link enviado por e-mail tem o valor cru, que
// só existe fora do banco.
model TokenRecuperacaoSenha {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([email, criadoEm])
}

// Login adicional para um funcionário do revendedor. Compartilha os
// mesmos dados (tudo é escopado por revendedorId, que aqui aponta pro
// dono/tenant), mas não pode gerenciar credenciais de pagamento nem
// outros funcionários.
model Funcionario {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  nome         String
  email        String  @unique
  senhaHash    String
  ativo        Boolean @default(true)
  criadoEm     DateTime @default(now())

  // Permissões granulares — default false preserva o comportamento de
  // antes dessas colunas existirem (funcionário não excluía nada nem via
  // financeiro) pra quem já estava cadastrado; o dono libera cada uma por
  // funcionário depois, se quiser.
  podeExcluir       Boolean @default(false)
  podeVerFinanceiro Boolean @default(false)

  @@index([revendedorId])
}

// Inscrição de notificação push (Web Push) de um dispositivo do
// revendedor ou de um funcionário dele, usada pelo lembrete diário.
model PushSubscription {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  endpoint     String @unique
  p256dh       String
  auth         String
  criadoEm     DateTime @default(now())

  @@index([revendedorId])
}

model Servico {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  nome         String
  criadoEm     DateTime @default(now())

  plataformaId      String?
  plataforma        Plataforma? @relation(fields: [plataformaId], references: [id], onDelete: SetNull)
  custoCredito      Float?
  cobrancaTelaExtra Float?

  clientes   Cliente[]
  avisos     Aviso[]
  renovacoes Renovacao[]

  @@unique([revendedorId, nome])
  @@index([plataformaId])
}

model Plataforma {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  nome         String
  url          String?
  minimo       Int    @default(0)
  criadoEm     DateTime @default(now())

  lotes    LotePlataforma[]
  servicos Servico[]

  @@unique([revendedorId, nome])
}

model LotePlataforma {
  id           String @id @default(cuid())
  plataformaId String
  plataforma   Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Cascade)
  quantidade   Int
  valorPago    Float
  data         DateTime @default(now())

  @@index([plataformaId])
}

model Cliente {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  servicoId    String?
  servico      Servico? @relation(fields: [servicoId], references: [id])

  nome      String
  cpf       String?
  whatsapp  String?
  telas     Int      @default(1)

  plano       PlanoCliente
  valorPlano  Float
  vencimento  DateTime
  diaFixo     Int?
  testeGratis Boolean  @default(false)
  status      StatusCliente @default(ATIVO)

  anotacao        String?
  motivoSaida     String?
  motivoSaidaData DateTime?

  // Quem indicou esse cliente pro revendedor, se algum cliente já
  // cadastrado indicou — pra saber quem são os melhores "promotores".
  indicadoPorId String?
  indicadoPor   Cliente?  @relation("Indicacoes", fields: [indicadoPorId], references: [id], onDelete: SetNull)
  indicados     Cliente[] @relation("Indicacoes")

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  renovacoes    Renovacao[]
  pagamentos    Pagamento[]
  vendas        Venda[]
  cobrancas     Cobranca[]
  avisosEnviados AvisoEnvio[]
  notificacoesPagamento NotificacaoPagamento[]

  @@index([revendedorId, status])
  @@index([revendedorId, vencimento])
  @@index([indicadoPorId])
  @@index([servicoId])
}

// Avisa o revendedor no sininho do painel quando um cliente paga sozinho
// pelo link de autoatendimento (/pagar/[clienteId]) — mesmo a tela do
// cliente já atualizando sozinha, sem isso o revendedor só percebe o
// pagamento se for conferir manualmente.
model NotificacaoPagamento {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteNome  String
  valor        Float
  criadoEm     DateTime @default(now())

  @@index([revendedorId])
  @@index([clienteId])
}

// Marca quando um cliente recebeu um determinado modelo de aviso em massa,
// pra evitar reenviar o mesmo comunicado pra quem já recebeu.
model AvisoEnvio {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  modelo    String
  enviadoEm DateTime @default(now())

  @@unique([clienteId, modelo])
}

// Histórico de cada crédito financeiro que o dono do GestorPro concedeu a
// uma conta (ver Revendedor.saldoCreditos) — pra mostrar de onde veio cada
// valor do saldo atual, igual o histórico de recarga em LotePlataforma.
model CreditoConta {
  id           String     @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  quantidade   Float
  observacao   String?
  criadoEm     DateTime   @default(now())

  @@index([revendedorId])
}

// Registro de cada vez que uma mensagem de cobrança é enviada pro cliente
// pelo WhatsApp — usado só pra calcular a pontualidade (quantas cobranças
// foram precisas por pagamento recebido).
model Cobranca {
  id        String @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  modelo    String
  criadoEm  DateTime @default(now())

  @@index([clienteId, criadoEm])
}

model Renovacao {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plano     PlanoCliente
  valor     Float
  custo     Float    @default(0)
  data      DateTime @default(now())

  // Como o pagamento chegou — nulo pros registros antigos (lançados antes
  // desse campo existir) e pras renovações automáticas via gateway, que já
  // guardam isso em Pagamento; aqui é só pra tela de Vendas mostrar a forma
  // junto de cada linha do extrato, igual já faz com Venda.formaPagamento.
  formaPagamento String?

  // Presente só quando essa renovação nasceu junto de uma venda de aparelho
  // no mesmo lançamento (opção "Aparelho + assinatura" em Nova venda) — é
  // essa venda vinculada abaixo, em Venda.renovacaoId, que permite a tela de
  // Vendas juntar as duas linhas num "Combo" só, em vez de duplicar a
  // receita/custo como duas vendas separadas.
  vendaCombo Venda?

  // App do cliente NO MOMENTO dessa renovação — guardado aqui, não só no
  // Cliente, porque o cliente pode trocar de app depois. Sem isso, trocar o
  // app de um cliente puxava retroativamente todo o histórico de renovações
  // dele pra plataforma nova no cálculo de saldo/usados (e devolvia crédito
  // pra plataforma antiga), mesmo as renovações lançadas quando ele ainda
  // usava o app anterior.
  servicoId String?
  servico   Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)

  // Estado do cliente (plano/valorPlano/vencimento/status/testeGratis) logo
  // antes desta renovação ser aplicada — guardado só pra permitir desfazer
  // um lançamento errado (ex: renovou o cliente errado sem querer) com
  // segurança, restaurando o cliente pro estado exato de antes em vez de
  // tentar recalcular a data na mão. Renovações de antes dessa coluna
  // existir ficam sem esse snapshot e por isso não podem ser desfeitas.
  snapshotAnterior Json?

  @@index([clienteId])
  @@index([servicoId])
}

model Produto {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)

  modelo        String
  estoqueMinimo Int    @default(0)
  criadoEm      DateTime @default(now())

  movimentos MovimentoEstoque[]
  vendas     Venda[]

  @@unique([revendedorId, modelo])
}

model MovimentoEstoque {
  id            String @id @default(cuid())
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo          TipoMovimentoEstoque
  quantidade    Int
  custoUnitario Float
  fornecedor    String?
  data          DateTime @default(now())

  @@index([produtoId])
}

model Venda {
  id             String @id @default(cuid())
  revendedorId   String
  revendedor     Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        Produto @relation(fields: [produtoId], references: [id])
  clienteId      String?
  cliente        Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  // Só preenchido no combo "Aparelho + assinatura" de Nova venda — a
  // renovação lançada junto nesse mesmo combo. Ver comentário em
  // Renovacao.vendaCombo.
  renovacaoId    String? @unique
  renovacaoCombo Renovacao? @relation(fields: [renovacaoId], references: [id], onDelete: SetNull)

  quantidade      Int
  valorUnitario   Float
  // Custo real dos lotes consumidos por FIFO no momento da venda (não é
  // recalculado depois) — mesma lógica de "grava e nunca reajusta sozinho"
  // já usada em Renovacao.custo, pra relatórios de meses passados não
  // mudarem se o custo médio do produto mudar depois.
  custoUnitario   Float @default(0)
  formaPagamento  String
  taxaPercentual  Float @default(0)
  data            DateTime @default(now())

  @@index([revendedorId])
  @@index([produtoId])
  @@index([clienteId])
}

model ChavePix {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  tipo         String
  valor        String
  criadoEm     DateTime @default(now())

  @@index([revendedorId])
}

model ModeloMensagem {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  chave        String
  texto        String

  @@unique([revendedorId, chave])
}

model Aviso {
  id           String @id @default(cuid())
  revendedorId String?
  revendedor   Revendedor? @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  servicoId    String?
  servico      Servico? @relation(fields: [servicoId], references: [id])

  destino  DestinoAviso
  tipo     TipoAviso @default(GERAL)
  titulo   String
  mensagem String
  criadoEm DateTime @default(now())

  @@index([revendedorId])
  @@index([servicoId])
}

// Canal na direção contrária do Aviso: o revendedor manda uma dica/sugestão
// pra Administração GestorPro (não pro cliente dele) — aparece no Painel do
// administrador com o nome de quem mandou e a mensagem.
model Sugestao {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)

  mensagem String
  lida     Boolean  @default(false)
  // Sinalizada pelo admin como uma boa ideia pra colocar no roteiro do
  // produto — não muda o fluxo de leitura, só destaca na aba Sugestões.
  destaque Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([revendedorId])
}

model Interessado {
  id          String   @id @default(cuid())
  nome        String
  whatsapp    String
  interesse   String?
  retornarEm  DateTime?
  observacao  String?
  convertido  Boolean  @default(false)
  criadoEm    DateTime @default(now())
}

// Leads do próprio revendedor — pessoas interessadas em virar clientes
// dele (diferente de Interessado, que é lead de assinatura do GestorPro).
model InteressadoCliente {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)

  nome       String
  whatsapp   String
  interesse  String?
  retornarEm DateTime?
  observacao String?
  convertido Boolean  @default(false)
  criadoEm   DateTime @default(now())

  @@index([revendedorId, convertido])
}

model FechamentoMes {
  id             String @id @default(cuid())
  revendedorId   String
  revendedor     Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  ano            Int
  mes            Int
  receita        Float
  custo          Float
  lucro          Float
  clientesAtivos Int @default(0)
  fechadoEm      DateTime @default(now())

  @@unique([revendedorId, ano, mes])
}

// Registro de cada preferência de pagamento criada no Mercado Pago,
// tanto para a assinatura do GestorPro quanto para a renovação de um
// cliente. O webhook nunca confia no corpo recebido: ele usa este
// registro para saber qual token consultar na API do Mercado Pago.
model Pagamento {
  id           String @id @default(cuid())
  revendedorId String
  revendedor   Revendedor @relation(fields: [revendedorId], references: [id], onDelete: Cascade)
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  tipo   TipoPagamento
  status StatusPagamento @default(PENDENTE)

  plano         PlanoCliente?
  valor         Float
  custo         Float @default(0)
  meses         Int?

  // Valor líquido depois de descontar a taxa do Mercado Pago (preenchido
  // pelo webhook, a partir do net_received_amount que o MP devolve, só pra
  // pagamento de ASSINATURA aprovado por ele) — é o que entra de fato na
  // receita mostrada pro admin. Continua null pra pagamento pendente/
  // recusado e pra RENOVACAO (isso é receita do próprio revendedor, não da
  // plataforma). "valor" nunca muda: continua sendo o preço cobrado do
  // revendedor, pra recibo/checkout baterem com o que ele efetivamente pagou.
  valorLiquido Float?

  mpPreferenceId String? @unique
  mpPaymentId    String? @unique
  asaasPaymentId String? @unique

  cupomId String?
  cupom   Cupom?  @relation(fields: [cupomId], references: [id], onDelete: SetNull)

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([revendedorId, status])
  @@index([clienteId])
  @@index([cupomId])
}

// Cupom de desconto pra assinatura do GestorPro (não é dos clientes do
// revendedor — é o admin vendendo o próprio GestorPro).
model Cupom {
  id     String @id @default(cuid())
  codigo String @unique

  tipo  TipoCupom
  valor Float // percentual (0-100) se tipo=PERCENTUAL, ou reais se tipo=FIXO

  ativo      Boolean   @default(true)
  validoAte  DateTime?
  usoMaximo  Int?
  usosCount  Int       @default(0)

  // Restringe o cupom a um único revendedor (ex: negociação individual) —
  // null significa que qualquer revendedor pode usar, respeitando ainda
  // usoMaximo e validoAte.
  revendedorId String?
  revendedor   Revendedor? @relation(fields: [revendedorId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  pagamentos Pagamento[]

  @@index([revendedorId])
}
