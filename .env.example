# Copie este arquivo para .env e preencha os valores.

# Connection string do Postgres usada pelo APP em runtime. Em produção use a
# do Supabase — no botão "Connect" do projeto, aba "Transaction pooler"
# (porta 6543, host aws-0-<região>.pooler.supabase.com, usuário
# postgres.<ref-do-projeto>, com ?pgbouncer=true no final).
# NÃO use a conexão direta (db.<ref>.supabase.co): ela só aceita IPv6 e não
# funciona a partir da Vercel nem de várias redes.
# Em dev local, pode ser um Postgres na sua máquina.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestorpro"

# Connection string usada só pelo Prisma Migrate durante o build (o script
# vercel-build). Use a aba "Session pooler" (porta 5432) do mesmo projeto —
# migrações usam locks que o pooler em modo "transaction" (6543) não
# sustenta direito. Se não definir, cai de volta pra DATABASE_URL.
DIRECT_URL=""

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# WhatsApp (com DDI+DDD, só números) para onde o botão "pagar no Pix" leva o revendedor
SUPORTE_WHATSAPP="5500000000000"

# Token compartilhado só pra confirmar o webhook do WhatsApp Cloud API
# (src/app/api/webhooks/whatsapp) — o mesmo valor pra todos os revendedores,
# cadastrado por cada um no campo "Verify Token" do próprio app da Meta.
# Gere qualquer string aleatória com: openssl rand -hex 20
WHATSAPP_VERIFY_TOKEN=""

# Mercado Pago da PLATAFORMA — recebe o pagamento das assinaturas do GestorPro.
# Credenciais de produção em https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# URL pública do app, sem barra no final (usada nos links de retorno do
# checkout e na URL do webhook que você cadastra no Mercado Pago).
APP_URL="http://localhost:3000"

# Chaves VAPID para notificação push (lembrete diário). Gere um par novo com:
# node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# A pública também precisa estar como NEXT_PUBLIC_VAPID_PUBLIC_KEY (mesmo valor).
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:suporte@example.com"

# Chave pra criptografar credenciais de contas de terceiros guardadas no
# banco (ex: senha da UniTV) — diferente do AUTH_SECRET, essa nunca pode
# mudar depois que a primeira credencial for salva, senão perde o acesso a
# tudo que já estava criptografado com a chave antiga.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# Segredo que protege a rota do cron diário (/api/cron/lembrete-diario).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Configure o MESMO valor na Vercel (Settings > Environment Variables) — a
# Vercel Cron manda esse valor automaticamente como Authorization: Bearer.
CRON_SECRET=""

# E-mail transacional (recuperação de senha, comunicados) via Resend
# (resend.com). Pegue a API key em resend.com/api-keys — o domínio do
# endereço em EMAIL_FROM precisa estar verificado lá (aba Domains, com os
# registros DNS SPF/DKIM que eles pedem) antes de mandar pra qualquer e-mail
# além do seu próprio de teste. Sem a key configurada, o app não trava: só
# loga o e-mail (e o link) no console em vez de enviar de verdade — dá pra
# testar a tela inteira sem a key.
RESEND_API_KEY=""
EMAIL_FROM="GestorPro <naoresponda@meugestorpro.app.br>"

# Monitoramento de erros em produção (sentry.io, tem plano grátis). Crie um
# projeto lá (tipo "Next.js") e cole a DSN dele aqui — DSN não é segredo,
# é feita pra ir no bundle do navegador também, por isso o mesmo valor serve
# pros dois. Sem configurar, o app não trava: só não reporta nada pro Sentry.
NEXT_PUBLIC_SENTRY_DSN=""
# Opcionais — só necessários se quiser o upload automático de source maps
# (facilita ver a linha exata do erro no painel do Sentry). Em Settings >
# Auth Tokens no Sentry, e o nome da org/projeto aparecem na URL do projeto.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
